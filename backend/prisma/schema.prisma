// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

model Candidate {
  id               Int               @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String            @unique
  phone            String?
  address          String?
  educations       Education[]
  workExperiences  WorkExperience[]
  resumes          Resume[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Education {
  id           Int       @id @default(autoincrement())
  candidateId  Int
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution  String
  title        String
  startDate    DateTime
  endDate      DateTime?

  @@index([candidateId])
}

model WorkExperience {
  id           Int       @id @default(autoincrement())
  candidateId  Int
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company      String
  position     String
  description  String?
  startDate    DateTime
  endDate      DateTime?

  @@index([candidateId])
}

model Resume {
  id           Int       @id @default(autoincrement())
  candidateId  Int
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  filePath     String
  fileType     String
  uploadDate   DateTime  @default(now())

  @@index([candidateId])
}
